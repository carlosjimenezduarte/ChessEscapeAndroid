  m_SharedData: {fileID: 11400000, guid: 96de11300926c0d4e9b8e616013fe5be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10415656960
    m_Localized: "Quando raggiunse la sala 100, l\u2019uomo ricevette una visita
      inaspettata."
    m_Metadata:
      m_Items: []
  - m_Id: 13158731776
    m_Localized: "Il Genio lo felicit\xF2 per il suo impegno e lo incoraggi\xF2 a
      perseverare fino alla fine."
    m_Metadata:
      m_Items: []
  - m_Id: 17453699072
    m_Localized: "Poi gli parl\xF2 dell\u2019esistenza di un Forziere Leggendario\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 20037390336
    m_Localized: "\xAB\u2026un tesoro che pu\xF2 essere aperto solo con i tre frammenti
      della Chiave Sacra\xBB, afferm\xF2 il Genio."
    m_Metadata:
      m_Items: []
  - m_Id: 22855962624
    m_Localized: "\xABSe riuscirai ad aprire quel Forziere, smetterai di essere solo
      una Pedina\u2026 e diventerai un vero Re Incoronato\xBB, assicur\xF2 il Genio."
    m_Metadata:
      m_Items: []
  - m_Id: 27385810944
    m_Localized: "Con quella promessa, l\u2019uomo rinnov\xF2 le sue forze e accett\xF2
      le sfide che ancora lo attendevano."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

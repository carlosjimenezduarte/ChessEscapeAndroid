  m_SharedData: {fileID: 11400000, guid: 96de11300926c0d4e9b8e616013fe5be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10415656960
    m_Localized: "Ao chegar \xE0 sala 100, o homem recebeu uma visita inesperada."
    m_Metadata:
      m_Items: []
  - m_Id: 13158731776
    m_Localized: "O G\xE9nio o parabenizou pelo seu compromisso e o incentivou a
      perseverar at\xE9 o fim."
    m_Metadata:
      m_Items: []
  - m_Id: 17453699072
    m_Localized: "Ent\xE3o lhe falou da exist\xEAncia de um Cofre Lend\xE1rio\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 20037390336
    m_Localized: "\u201C\u2026um tesouro que s\xF3 pode ser aberto com os tr\xEAs
      fragmentos da Chave Sagrada\u201D, afirmou o G\xE9nio."
    m_Metadata:
      m_Items: []
  - m_Id: 22855962624
    m_Localized: "\u201CSe conseguires abrir esse Cofre, deixar\xE1s de ser apenas
      uma Pe\xE7a\u2026 e te tornar\xE1s um verdadeiro Rei Coroado\u201D, assegurou
      o G\xE9nio."
    m_Metadata:
      m_Items: []
  - m_Id: 27385810944
    m_Localized: "Com essa promessa, o homem renovou suas for\xE7as e aceitou os
      desafios que ainda o aguardavam."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

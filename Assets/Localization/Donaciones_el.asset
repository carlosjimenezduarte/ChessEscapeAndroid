      m_Items: []
  - m_Id: 69861527552
    m_Localized: "\u039F \u039A\u03AC\u03C1\u03BB\u03BF\u03C2 \u03C0\u03C1\u03AD\u03C0\u03B5\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03C4\u03BF\u03C5
      ChatGPT \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03B5\u03B9
      \u03BD\u03B1 \u03B1\u03BD\u03B1\u03C0\u03C4\u03CD\u03C3\u03C3\u03B5\u03B9 \u03B2\u03B9\u03BD\u03C4\u03B5\u03BF\u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1!"
    m_Metadata:
      m_Items: []
  - m_Id: 83283300352
    m_Localized: "\u0388\u03BD\u03B1 \u03BA\u03B1\u03BB\u03CC \u03C6\u03BB\u03B9\u03C4\u03B6\u03AC\u03BD\u03B9
      \u03BA\u03B1\u03C6\u03AD \u03B8\u03B1 \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9
      \u03C4\u03BF\u03BD \u039A\u03AC\u03C1\u03BB\u03BF\u03C2 \u03BD\u03B1 \u03C6\u03C4\u03B9\u03AC\u03BE\u03B5\u03B9
      \u03C4\u03B1 \u03C0\u03B1\u03B9\u03C7\u03BD\u03AF\u03B4\u03B9\u03B1 \u03C4\u03BF\u03C5
      \u03BC\u03B5 \u03C0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B7
      \u03CC\u03C1\u03B5\u03BE\u03B7!"
    m_Metadata:
      m_Items: []
  - m_Id: 133010968576
    m_Localized: "\u039F \u039A\u03AC\u03C1\u03BB\u03BF\u03C2 \u03B8\u03AD\u03BB\u03B5\u03B9
      \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2 \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C1\u03CE\u03C3\u03B5\u03B9
      \u03C4\u03B7 \u03C3\u03C5\u03BD\u03B4\u03C1\u03BF\u03BC\u03AE \u03C4\u03BF\u03C5
      Dofus \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03C3\u03C5\u03BD\u03B5\u03C7\u03AF\u03C3\u03B5\u03B9
      \u03BD\u03B1 \u03B5\u03BC\u03C0\u03BD\u03AD\u03B5\u03C4\u03B1\u03B9 \u03B4\u03B9\u03B1\u03C3\u03BA\u03B5\u03B4\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03C2!"
    m_Metadata:
      m_Items: []
  - m_Id: 148915769344
    m_Localized: "\u039F \u039A\u03AC\u03C1\u03BB\u03BF\u03C2 \u03BF\u03BD\u03B5\u03B9\u03C1\u03B5\u03CD\u03B5\u03C4\u03B1\u03B9

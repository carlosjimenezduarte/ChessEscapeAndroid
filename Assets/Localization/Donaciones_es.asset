  m_TableData:
  - m_Id: 39297634304
    m_Localized: "Puedes apoyar a Saint Martin Games directamente a trav\xE9s de
      las donaciones de ChessEscape.com"
    m_Metadata:
      m_Items: []
  - m_Id: 53583433728
    m_Localized: "\xA1Las croquetas de Willow no se pagan solas!"
    m_Metadata:
      m_Items: []
  - m_Id: 69861527552
    m_Localized: "\xA1Carlos tambi\xE9n tiene que pagar la suscripci\xF3n a ChatGPT
      para seguir desarrollando videojuegos!"
    m_Metadata:
      m_Items: []
  - m_Id: 83283300352
    m_Localized: "\xA1Una buena taza de caf\xE9 ayudar\xE1 a que Carlos elabore sus
      juegos con m\xE1s entusiasmo!"
    m_Metadata:
      m_Items: []
  - m_Id: 133010968576
    m_Localized: "\xA1Carlos tambi\xE9n desea pagar la suscripci\xF3n de Dofus para
      seguir inspir\xE1ndose mientras se divierte!"
    m_Metadata:
      m_Items: []
  - m_Id: 148915769344
    m_Localized: "\xA1Carlos sue\xF1a con comprar su propia casa\u2026 tu apoyo tambi\xE9n
      construye ese futuro!"
    m_Metadata:
      m_Items: []
  - m_Id: 163209957376
    m_Localized: "Saber m\xE1s"
    m_Metadata:
      m_Items: []

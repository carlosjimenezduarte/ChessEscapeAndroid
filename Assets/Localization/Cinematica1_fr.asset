  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cinematica1_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: c2d267b057669f54da106f121bf5e76b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 164489220096
    m_Localized: "Il y avait un homme qui avait tout perdu et erra sans but pendant
      de longues ann\xE9es."
    m_Metadata:
      m_Items: []
  - m_Id: 170336079872
    m_Localized: "Parmi des ruines anciennes, il trouva une lampe dor\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 172420648960
    m_Localized: "Un G\xE9nie resplendissant en sortit, offrant d\u2019exaucer un
      seul souhait."
    m_Metadata:
      m_Items: []
  - m_Id: 177554477056
    m_Localized: "\xAB Je veux \xEAtre Roi. Je veux un Royaume \xE0 moi \xBB, r\xE9pondit
      l\u2019homme."
    m_Metadata:
      m_Items: []
  - m_Id: 181543260160
    m_Localized: "Le G\xE9nie r\xE9pondit : \xAB Ton souhait sera exauc\xE9. Mais
      aucun Royaume n\u2019est donn\xE9 sans \xE9preuves. \xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 184470884352
    m_Localized: "\xAB Si tu veux vraiment \xEAtre Roi, entre d\xE8s maintenant dans
      cette salle. Ton Royaume t\u2019attend \xBB, l\u2019invita le G\xE9nie."
    m_Metadata:
      m_Items: []
  - m_Id: 186479955968
    m_Localized: "\xC9mu, l\u2019homme entra dans la premi\xE8re salle, o\xF9 il
      d\xE9couvrit avec d\xE9ception qu\u2019elle \xE9tait remplie de pi\xE8ces d\u2019\xE9checs."
    m_Metadata:
      m_Items: []
  - m_Id: 188791017472
    m_Localized: "Alors le G\xE9nie transforma l\u2019homme en un Roi d\u2019\xE9checs,
      dont la peau se fondit avec celle de l\u2019\xE9chiquier."
    m_Metadata:
      m_Items: []
  - m_Id: 190506487808
    m_Localized: "Deux cents salles d\u2019\xE9preuve attendent le Roi. Deux cents
      \xE9preuves pour mesurer la conviction de son d\xE9sir. Deux cents \xE9preuves
      pour conqu\xE9rir son propre Royaume."
    m_Metadata:
      m_Items: []
  - m_Id: 193123733504
    m_Localized: "Aideras-tu cet homme \xE0 devenir un v\xE9ritable Roi ? Seras-tu
      capable de le guider ?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

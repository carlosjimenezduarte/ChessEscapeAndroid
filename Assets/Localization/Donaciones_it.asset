  m_TableData:
  - m_Id: 39297634304
    m_Localized: Puoi supportare Saint Martin Games direttamente tramite le donazioni
      su ChessEscape.com
    m_Metadata:
      m_Items: []
  - m_Id: 53583433728
    m_Localized: Le crocchette di Willow non si pagano da sole!
    m_Metadata:
      m_Items: []
  - m_Id: 69861527552
    m_Localized: "Carlos deve anche pagare l\u2019abbonamento a ChatGPT per continuare
      a sviluppare videogiochi!"
    m_Metadata:
      m_Items: []
  - m_Id: 83283300352
    m_Localized: "Una buona tazza di caff\xE8 aiuter\xE0 Carlos a creare i suoi giochi
      con pi\xF9 entusiasmo!"
    m_Metadata:
      m_Items: []
  - m_Id: 133010968576
    m_Localized: "Carlos vuole anche pagare l\u2019abbonamento a Dofus per continuare
      a ispirarsi divertendosi!"
    m_Metadata:
      m_Items: []
  - m_Id: 148915769344
    m_Localized: "Carlos sogna di comprare la sua casa\u2026 il tuo supporto costruisce
      anche quel futuro!"
    m_Metadata:
      m_Items: []
  - m_Id: 163209957376
    m_Localized: "Scopri di pi\xF9"
    m_Metadata:
      m_Items: []

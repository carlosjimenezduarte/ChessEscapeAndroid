  m_TableData:
  - m_Id: 230618705920
    m_Localized: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0443\u0447\u0435\u0431\u043D\u0438\u043A ChessEscape."
    m_Metadata:
      m_Items: []
  - m_Id: 237124071424
    m_Localized: "ChessEscape \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 204
      \u0443\u0440\u043E\u0432\u043D\u0435\u0439, \u0433\u0434\u0435 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u0430\u044F \u0434\u043E\u0441\u043A\u0430
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0430\u0440\u0435\u043D\u043E\u0439,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u044B \u0438\u0441\u043F\u044B\u0442\u0430\u0435\u0448\u044C
      \u0441\u0432\u043E\u0439 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 240546623488
    m_Localized: "\u0412\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u2014 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u041A\u043E\u0440\u043E\u043B\u044F \u043A \u0432\u0435\u0440\u0445\u043D\u0435\u0439
      \u043F\u0440\u0430\u0432\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0435,
      \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u0432\u0435\u0440\u044C.
      \u042D\u0442\u0430 \u043A\u043B\u0435\u0442\u043A\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
      H8 \u043D\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u043E\u0439 \u0434\u043E\u0441\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1643788775424
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0432 \u043D\u0438\u0436\u043D\u0435\u043C
      \u043B\u0435\u0432\u043E\u043C \u0443\u0433\u043B\u0443, \u0442\u043E \u0435\u0441\u0442\u044C
      \u043D\u0430 \u043A\u043B\u0435\u0442\u043A\u0435 A1."
    m_Metadata:
      m_Items: []
  - m_Id: 1674725961728
    m_Localized: "\u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E
      \u041A\u043E\u0440\u043E\u043B\u044C \u0438\u043C\u0435\u0435\u0442 3 \u041E\u0447\u043A\u0430
      \u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F (\u041E\u041F)
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1708913733632
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0435\u0433\u043E
      \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435, \u0435\u0433\u043E
      \u0437\u043E\u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0435\u043B\u0451\u043D\u044B\u043C \u0446\u0432\u0435\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1739418906624
    m_Localized: "\u0422\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0451\u0442,
      \u0435\u0441\u043B\u0438 \u0432\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0442\u0435
      \u041F\u0435\u0448\u043A\u0443 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0421\u043E\u044E\u0437\u043D\u0443\u044E \u0424\u0438\u0433\u0443\u0440\u0443,
      \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u041A\u043E\u043D\u044F,
      \u0421\u043B\u043E\u043D\u0430, \u041B\u0430\u0434\u044C\u044E \u0438\u043B\u0438
      \u0424\u0435\u0440\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4847662411776
    m_Localized: "\u041E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0437\u043E\u043D\u044B \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C,
      \u043D\u0430\u0436\u0430\u0432 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E
      \u043D\u0430 \u0442\u0443 \u0436\u0435 \u0444\u0438\u0433\u0443\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4782298378240
    m_Localized: "\u041F\u0440\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0438 \u043A\u043D\u043E\u043F\u043A\u0438
      \xAB\u041D\u0430\u0447\u0430\u0442\u044C\xBB \u041A\u043E\u0440\u043E\u043B\u044C
      \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D \u043F\u043E
      \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 5022481002496
    m_Localized: "\u041A\u043E\u0440\u043E\u043B\u044C \u0438 \u0421\u043E\u044E\u0437\u043D\u044B\u0435
      \u0424\u0438\u0433\u0443\u0440\u044B \u043C\u043E\u0433\u0443\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C
      \u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0424\u0438\u0433\u0443\u0440\u044B,
      \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0438\u0445 \u0437\u043E\u043D\u044B
      \u0430\u0442\u0430\u043A\u0438. \u0424\u0443\u043A\u0441\u0438\u0435\u0432\u0430\u044F
      \u043A\u043B\u0435\u0442\u043A\u0430 \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u0430 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5100088209408
    m_Localized: "\u0414\u043B\u044F \u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0424\u0438\u0433\u0443\u0440 \u043F\u0440\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0438
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0438\u0445
      \u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0417\u043E\u043D\u0430
      \u0410\u0442\u0430\u043A\u0438 \u0438 \u0414\u0430\u043B\u044C\u043D\u044F\u044F
      \u0417\u043E\u043D\u0430 \u0410\u0442\u0430\u043A\u0438. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5127837724672
    m_Localized: "\u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E
      \u041A\u043E\u0440\u043E\u043B\u044C \u0438\u043C\u0435\u0435\u0442 5 \u041E\u0447\u043A\u043E\u0432
      \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044F (\u041E\u0414) \u0437\u0430
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434. \u041E\u043D\u0438
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u041A\u043E\u0440\u043E\u043B\u044C
      \u043C\u043E\u0433 \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0421\u043E\u044E\u0437\u043D\u044B\u043C \u0424\u0438\u0433\u0443\u0440\u0430\u043C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5158242234368
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434 \u0434\u043B\u0438\u0442\u0441\u044F
      30 \u0441\u0435\u043A\u0443\u043D\u0434. \u0415\u0441\u043B\u0438 \u0432\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0417\u043E\u043B\u043E\u0442\u044B\u0435
      \u0427\u0430\u0441\u044B, \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u0441\u044F
      \u0435\u0449\u0451 15 \u0441\u0435\u043A\u0443\u043D\u0434 \u043A \u044D\u0442\u043E\u043C\u0443
      \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5188302811136
    m_Localized: "\u0423 \u041A\u043E\u0440\u043E\u043B\u044F \u0435\u0441\u0442\u044C
      7 \u0416\u0438\u0437\u043D\u0435\u0439 (\u0445\u043E\u0434\u043E\u0432), \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5223002288128
    m_Localized: "\u0422\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0430\u044E\u0442 \u041A\u043E\u0440\u043E\u043B\u044E \u041E\u0414
      \u0438 \u041E\u041F \u0438\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442
      \u0437\u043E\u043D\u0443 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0421\u043E\u044E\u0437\u043D\u044B\u0445 \u0424\u0438\u0433\u0443\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 5251418697728
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u0445 \u0438 \u0444\u0438\u0433\u0443\u0440\u0430\u0445
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0432 \u041A\u043E\u0434\u0435\u043A\u0441\u0435
      ChessEscape."
    m_Metadata:
      m_Items: []
  - m_Id: 5284742443008
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0439
      \u0441\u043E\u043E\u0431\u0449\u0438\u0442 \u0432\u0430\u043C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043D\u043E\u0432\u0443\u044E
      \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5317822918656
    m_Localized: "\u0412\u043E\u0442 \u0438 \u0432\u0441\u0451! \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0447\u0430\u0442\u044C
      \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0438 \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u041A\u043E\u0440\u043E\u043B\u044F \u0434\u043E \u0424\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u041A\u043E\u043C\u043D\u0430\u0442\u044B.\n\u0423 \u0432\u0430\u0441 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 262470894759936
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435
      \u0424\u0438\u0433\u0443\u0440\u044B \u0430\u0442\u0430\u043A\u0443\u044E\u0442
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438,
      \u043E\u043D\u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0442 \u041E\u041F
      \u0443 \u041A\u043E\u0440\u043E\u043B\u044F \u0438\u043B\u0438 \u041E\u0414,
      \u0435\u0441\u043B\u0438 \u044D\u0442\u043E \u0421\u043E\u044E\u0437\u043D\u0430\u044F
      \u0424\u0438\u0433\u0443\u0440\u0430. \u0412\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u0435
      \u044D\u0442\u043E \u043F\u043E \u043B\u0438\u043D\u0438\u0438 \u0443\u0433\u0440\u043E\u0437\u044B,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u043E\u0435\u0446\u0438\u0440\u0443\u0435\u0442
      \u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0430\u044F \u0424\u0438\u0433\u0443\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 397500686151680
    m_Localized: "\u042D\u0442\u043E \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0435
      \u0440\u0435\u0437\u044E\u043C\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442
      \u0432\u0441\u0435\u043B\u0435\u043D\u043D\u0443\u044E ChessEscape."

  m_TableData:
  - m_Id: 10415656960
    m_Localized: "\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0432 \u0437\u0430\u043B\u0430
      100, \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u0432\u0438\u0437\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 13158731776
    m_Localized: "\u0414\u0436\u0438\u043D\u043D \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u0438\u043B
      \u0435\u0433\u043E \u0441 \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u043F\u043E\u0431\u0443\u0434\u0438\u043B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 17453699072
    m_Localized: "\u0417\u0430\u0442\u0435\u043C \u043E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0438
      \u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E \u0421\u0443\u043D\u0434\u0443\u043A\u0430\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 20037390336
    m_Localized: "\xAB\u2026\u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0440\u0435\u043C\u044F \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0421\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u041A\u043B\u044E\u0447\u0430\xBB,
      \u2014 \u0437\u0430\u044F\u0432\u0438\u043B \u0414\u0436\u0438\u043D\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 22855962624
    m_Localized: "\xAB\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u0443\u0434\u0430\u0441\u0442\u0441\u044F
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u043E\u0442 \u0421\u0443\u043D\u0434\u0443\u043A,
      \u0442\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u0431\u044B\u0442\u044C \u043B\u0438\u0448\u044C \u0424\u0438\u0433\u0443\u0440\u043E\u0439\u2026
      \u0438 \u0441\u0442\u0430\u043D\u0435\u0448\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
      \u041A\u043E\u0440\u043E\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u041A\u043E\u0440\u043E\u043B\u0451\u043C\xBB,
      \u2014 \u0443\u0432\u0435\u0440\u0438\u043B \u0414\u0436\u0438\u043D\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 27385810944
    m_Localized: "\u0421 \u044D\u0442\u0438\u043C \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435\u043C
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u0438\u043B
      \u0441\u0432\u043E\u0438 \u0441\u0438\u043B\u044B \u0438 \u043F\u0440\u0438\u043D\u044F\u043B
      \u0432\u044B\u0437\u043E\u0432\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0435\u0449\u0451 \u043E\u0436\u0438\u0434\u0430\u043B\u0438 \u0435\u0433\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

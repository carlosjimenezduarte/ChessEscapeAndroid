  m_TableData:
  - m_Id: 164489220096
    m_Localized: "\u0416\u0438\u043B-\u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0432\u0441\u0451 \u0438 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442
      \u0441\u043A\u0438\u0442\u0430\u043B\u0441\u044F \u0431\u0435\u0437 \u0446\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 170336079872
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u0434\u0440\u0435\u0432\u043D\u0438\u0445
      \u0440\u0443\u0438\u043D \u043E\u043D \u043D\u0430\u0448\u0451\u043B \u0437\u043E\u043B\u043E\u0442\u0443\u044E
      \u043B\u0430\u043C\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 172420648960
    m_Localized: "\u0418\u0437 \u043D\u0435\u0451 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u0441\u0438\u044F\u044E\u0449\u0438\u0439 \u0414\u0436\u0438\u043D\u043D,
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u0439 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043E\u0434\u043D\u043E-\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 177554477056
    m_Localized: "\xAB\u042F \u0445\u043E\u0447\u0443 \u0441\u0442\u0430\u0442\u044C
      \u041A\u043E\u0440\u043E\u043B\u0451\u043C. \u0425\u043E\u0447\u0443 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E\xBB, \u2014
      \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 181543260160
    m_Localized: "\u0414\u0436\u0438\u043D\u043D \u043E\u0442\u0432\u0435\u0442\u0438\u043B:
      \xAB\u0422\u0432\u043E\u0451 \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u043E. \u041D\u043E \u043D\u0438
      \u043E\u0434\u043D\u043E \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E
      \u043D\u0435 \u0434\u0430\u0451\u0442\u0441\u044F \u0431\u0435\u0437 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 184470884352
    m_Localized: "\xAB\u0415\u0441\u043B\u0438 \u0442\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u0442\u0430\u0442\u044C \u041A\u043E\u0440\u043E\u043B\u0451\u043C,
      \u0432\u043E\u0439\u0434\u0438 \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441
      \u0432 \u044D\u0442\u0443 \u0437\u0430\u043B\u0443. \u0422\u0432\u043E\u0451
      \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E \u0436\u0434\u0451\u0442
      \u0442\u0435\u0431\u044F\xBB, \u2014 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B
      \u0435\u0433\u043E \u0414\u0436\u0438\u043D\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 186479955968
    m_Localized: "\u0412\u043E\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0451\u043D\u043D\u044B\u0439,
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432\u043E\u0448\u0451\u043B \u0432
      \u043F\u0435\u0440\u0432\u0443\u044E \u0437\u0430\u043B\u0443 \u0438 \u0441
      \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E \u043E\u043D\u0430
      \u043F\u043E\u043B\u043D\u0430 \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u044B\u0445
      \u0444\u0438\u0433\u0443\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 188791017472
    m_Localized: "\u0418 \u0442\u043E\u0433\u0434\u0430 \u0414\u0436\u0438\u043D\u043D
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432 \u0448\u0430\u0445\u043C\u0430\u0442\u043D\u043E\u0433\u043E \u041A\u043E\u0440\u043E\u043B\u044F,
      \u043A\u043E\u0436\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u043B\u0438\u043B\u0430\u0441\u044C
      \u0441 \u0434\u043E\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 190506487808
    m_Localized: "\u0414\u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u043B\u043E\u0432
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439 \u0436\u0434\u0443\u0442
      \u041A\u043E\u0440\u043E\u043B\u044F. \u0414\u0432\u0435\u0441\u0442\u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u044C \u0441\u0438\u043B\u0443 \u0435\u0433\u043E
      \u0436\u0435\u043B\u0430\u043D\u0438\u044F. \u0414\u0432\u0435\u0441\u0442\u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u0432\u043E\u0435\u0432\u0430\u0442\u044C \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 193123733504
    m_Localized: "\u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043B\u0438 \u0442\u044B
      \u044D\u0442\u043E\u043C\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
      \u0441\u0442\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
      \u041A\u043E\u0440\u043E\u043B\u0451\u043C? \u0421\u0443\u043C\u0435\u0435\u0448\u044C
      \u043B\u0438 \u0442\u044B \u0432\u0435\u0441\u0442\u0438 \u0435\u0433\u043E?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

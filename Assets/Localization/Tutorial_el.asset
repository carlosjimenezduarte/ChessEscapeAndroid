  - m_Id: 230618705920
    m_Localized: "\u039A\u03B1\u03BB\u03CE\u03C2 \u03AE\u03C1\u03B8\u03B5\u03C2 \u03C3\u03C4\u03BF
      \u0395\u03BA\u03C0\u03B1\u03B9\u03B4\u03B5\u03C5\u03C4\u03B9\u03BA\u03CC \u03C4\u03BF\u03C5
      ChessEscape."
    m_Metadata:
      m_Items: []
  - m_Id: 237124071424
    m_Localized: "\u03A4\u03BF ChessEscape \u03B5\u03BA\u03C4\u03C5\u03BB\u03AF\u03C3\u03C3\u03B5\u03C4\u03B1\u03B9
      \u03C3\u03B5 204 \u03B5\u03C0\u03AF\u03C0\u03B5\u03B4\u03B1, \u03C3\u03C4\u03B1
      \u03BF\u03C0\u03BF\u03AF\u03B1 \u03B7 \u03C0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03C3\u03BA\u03B1\u03BA\u03B9\u03AD\u03C1\u03B1 \u03B3\u03AF\u03BD\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C3\u03BA\u03B7\u03BD\u03AE \u03CC\u03C0\u03BF\u03C5 \u03B8\u03B1
      \u03B4\u03BF\u03BA\u03B9\u03BC\u03AC\u03C3\u03B5\u03B9\u03C2 \u03C4\u03B7\u03BD
      \u03B5\u03C5\u03C6\u03C5\u0390\u03B1 \u03C3\u03BF\u03C5."
    m_Metadata:
      m_Items: []
  - m_Id: 240546623488
    m_Localized: "\u03A3\u03C4\u03CC\u03C7\u03BF\u03C2 \u03C3\u03BF\u03C5 \u03B5\u03AF\u03BD\u03B1\u03B9
      \u03BD\u03B1 \u03BF\u03B4\u03B7\u03B3\u03AE\u03C3\u03B5\u03B9\u03C2 \u03C4\u03BF\u03BD
      \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC \u03C3\u03C4\u03BF \u03C0\u03AC\u03BD\u03C9
      \u03B4\u03B5\u03BE\u03AF \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF,
      \u03CC\u03C0\u03BF\u03C5 \u03B2\u03C1\u03AF\u03C3\u03BA\u03B5\u03C4\u03B1\u03B9
      \u03B7 \u03C0\u03CC\u03C1\u03C4\u03B1. \u0391\u03C5\u03C4\u03CC \u03C4\u03BF
      \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03BF\u03B9\u03C7\u03B5\u03AF
      \u03C3\u03C4\u03BF H8 \u03C3\u03B5 \u03BC\u03B9\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B4\u03BF\u03C3\u03B9\u03B1\u03BA\u03AE
      \u03C3\u03BA\u03B1\u03BA\u03B9\u03AD\u03C1\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 1643788775424
    m_Localized: "\u039F \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03BE\u03B5\u03BA\u03B9\u03BD\u03AC
      \u03C0\u03AC\u03BD\u03C4\u03B1 \u03B1\u03C0\u03CC \u03C4\u03BF \u03BA\u03AC\u03C4\u03C9
      \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03CC \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF,
      \u03B4\u03B7\u03BB\u03B1\u03B4\u03AE \u03C4\u03BF A1."
    m_Metadata:
      m_Items: []
  - m_Id: 1674725961728
    m_Localized: "\u0391\u03C0\u03CC \u03C4\u03B7 \u03C6\u03CD\u03C3\u03B7 \u03C4\u03BF\u03C5,
      \u03BF \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03AD\u03C7\u03B5\u03B9
      3 \u03A0\u03CC\u03BD\u03C4\u03BF\u03C5\u03C2 \u039A\u03AF\u03BD\u03B7\u03C3\u03B7\u03C2
      (\u03A0\u039A) \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B3\u03CD\u03C1\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 1708913733632
    m_Localized: "\u038C\u03C4\u03B1\u03BD \u03C4\u03BF\u03BD \u03B5\u03C0\u03B9\u03BB\u03AD\u03B3\u03B5\u03B9\u03C2,
      \u03B8\u03B1 \u03B4\u03B5\u03B9\u03C2 \u03C4\u03B7\u03BD \u03B5\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03AC
      \u03C4\u03BF\u03C5 \u03BD\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03AF\u03B6\u03B5\u03C4\u03B1\u03B9
      \u03BC\u03B5 \u03C0\u03C1\u03AC\u03C3\u03B9\u03BD\u03BF \u03C7\u03C1\u03CE\u03BC\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 1739418906624
    m_Localized: "\u03A4\u03BF \u03AF\u03B4\u03B9\u03BF \u03B8\u03B1 \u03C3\u03C5\u03BC\u03B2\u03B5\u03AF
      \u03B1\u03BD \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03B9\u03C2 \u03C4\u03BF
      \u03A0\u03B9\u03CC\u03BD\u03B9 \u03AE \u03AC\u03BB\u03BB\u03B7 \u03A3\u03CD\u03BC\u03BC\u03B1\u03C7\u03B7
      \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B1, \u03CC\u03C0\u03C9\u03C2 \u03C4\u03BF\u03BD
      \u038A\u03C0\u03C0\u03BF, \u03C4\u03BF\u03BD \u0391\u03BE\u03B9\u03C9\u03BC\u03B1\u03C4\u03B9\u03BA\u03CC,
      \u03C4\u03BF\u03BD \u03A0\u03CD\u03C1\u03B3\u03BF \u03AE \u03C4\u03B7 \u0392\u03B1\u03C3\u03AF\u03BB\u03B9\u03C3\u03C3\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 4847662411776
    m_Localized: "\u0397 \u03B1\u03C0\u03B5\u03B9\u03BA\u03CC\u03BD\u03B9\u03C3\u03B7
      \u03C4\u03B7\u03C2 \u03B5\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03B1\u03C2 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF
      \u03BD\u03B1 \u03B1\u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03B7\u03B8\u03B5\u03AF
      \u03C0\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2 \u03BE\u03B1\u03BD\u03AC \u03C4\u03BF
      \u03AF\u03B4\u03B9\u03BF \u03C0\u03B9\u03CC\u03BD\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 4782298378240
    m_Localized: "\u039C\u03B5 \u03C4\u03BF \u03C0\u03AC\u03C4\u03B7\u03BC\u03B1
      \u03C4\u03BF\u03C5 \u03BA\u03BF\u03C5\u03BC\u03C0\u03B9\u03BF\u03CD \xAB\u0388\u03BD\u03B1\u03C1\u03BE\u03B7\xBB,
      \u03BF \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03B8\u03B1 \u03B5\u03C0\u03B9\u03BB\u03B5\u03B3\u03B5\u03AF
      \u03B1\u03C0\u03CC \u03C0\u03C1\u03BF\u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE."
    m_Metadata:
      m_Items: []
  - m_Id: 5022481002496
    m_Localized: "\u039F \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03BA\u03B1\u03B9
      \u03BF\u03B9 \u03A3\u03CD\u03BC\u03BC\u03B1\u03C7\u03B5\u03C2 \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B5\u03C2
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B5\u03BE\u03B1\u03BB\u03B5\u03AF\u03C8\u03BF\u03C5\u03BD
      \u03C4\u03B9\u03C2 \u0395\u03C7\u03B8\u03C1\u03B9\u03BA\u03AD\u03C2 \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03B5\u03C2
      \u03B1\u03BD \u03B2\u03C1\u03B5\u03B8\u03BF\u03CD\u03BD \u03BC\u03AD\u03C3\u03B1
      \u03C3\u03C4\u03B7\u03BD \u03B5\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03B1 \u03B5\u03C0\u03AF\u03B8\u03B5\u03C3\u03AE\u03C2
      \u03C4\u03BF\u03C5\u03C2. \u0388\u03BD\u03B1 \u03C6\u03BF\u03CD\u03BE\u03B9\u03B1
      \u03C4\u03B5\u03C4\u03C1\u03AC\u03B3\u03C9\u03BD\u03BF \u03B8\u03B1 \u03C6\u03C9\u03C4\u03B9\u03C3\u03C4\u03B5\u03AF
      \u03CC\u03C4\u03B1\u03BD \u03B1\u03C5\u03C4\u03AE \u03B7 \u03B5\u03C0\u03B9\u03BB\u03BF\u03B3\u03AE
      \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 5100088209408
    m_Localized: "\u03A3\u03C4\u03B7\u03BD \u03C0\u03B5\u03C1\u03AF\u03C0\u03C4\u03C9\u03C3\u03B7
      \u03C4\u03C9\u03BD \u0395\u03C7\u03B8\u03C1\u03B9\u03BA\u03CE\u03BD \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03C9\u03BD,
      \u03C0\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2 \u03C0\u03AC\u03BD\u03C9 \u03C4\u03BF\u03C5\u03C2
      \u03B8\u03B1 \u03B4\u03B5\u03B9\u03C2 \u03C4\u03B7\u03BD \u0398\u03B1\u03BD\u03AC\u03C3\u03B9\u03BC\u03B7
      \u0395\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03B1 \u0395\u03C0\u03AF\u03B8\u03B5\u03C3\u03B7\u03C2
      \u03BA\u03B1\u03B9 \u03C4\u03B7\u03BD \u0395\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03B1
      \u0395\u03C0\u03AF\u03B8\u03B5\u03C3\u03B7\u03C2 \u03B1\u03C0\u03CC \u0391\u03C0\u03CC\u03C3\u03C4\u03B1\u03C3\u03B7.
      \u03A0\u03AC\u03C4\u03B7\u03C3\u03B5 \u03BE\u03B1\u03BD\u03AC \u03B3\u03B9\u03B1
      \u03BD\u03B1 \u03C4\u03B7\u03BD \u03B1\u03C0\u03B5\u03BD\u03B5\u03C1\u03B3\u03BF\u03C0\u03BF\u03B9\u03AE\u03C3\u03B5\u03B9\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 5127837724672
    m_Localized: "\u0391\u03C0\u03CC \u03C4\u03B7 \u03C6\u03CD\u03C3\u03B7 \u03C4\u03BF\u03C5,
      \u03BF \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03AD\u03C7\u03B5\u03B9
      5 \u03A0\u03CC\u03BD\u03C4\u03BF\u03C5\u03C2 \u0394\u03C1\u03AC\u03C3\u03B7\u03C2
      (\u03A0\u0394) \u03C3\u03B5 \u03BA\u03AC\u03B8\u03B5 \u03B3\u03CD\u03C1\u03BF.
      \u0391\u03C5\u03C4\u03BF\u03AF \u03C7\u03C1\u03B5\u03B9\u03AC\u03B6\u03BF\u03BD\u03C4\u03B1\u03B9
      \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B4\u03B9\u03B1\u03C4\u03AC\u03BE\u03B5\u03B9
      \u03C4\u03B7\u03BD \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7 \u03C4\u03C9\u03BD
      \u03A3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03C9\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 5158242234368
    m_Localized: "\u039A\u03AC\u03B8\u03B5 \u03B3\u03CD\u03C1\u03BF\u03C2 \u03B4\u03B9\u03B1\u03C1\u03BA\u03B5\u03AF
      30 \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03B1.
      \u0391\u03BD \u03B1\u03C0\u03BF\u03BA\u03C4\u03AE\u03C3\u03B5\u03B9\u03C2 \u03AD\u03BD\u03B1
      \u03A7\u03C1\u03C5\u03C3\u03CC \u03A1\u03BF\u03BB\u03CC\u03B9, \u03B8\u03B1
      \u03BA\u03B5\u03C1\u03B4\u03AF\u03C3\u03B5\u03B9\u03C2 15 \u03B5\u03C0\u03B9\u03C0\u03BB\u03AD\u03BF\u03BD
      \u03B4\u03B5\u03C5\u03C4\u03B5\u03C1\u03CC\u03BB\u03B5\u03C0\u03C4\u03B1 \u03C3\u03B5
      \u03B1\u03C5\u03C4\u03CC\u03BD \u03C4\u03BF\u03BD \u03B3\u03CD\u03C1\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 5188302811136
    m_Localized: "\u039F \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2 \u03AD\u03C7\u03B5\u03B9
      7 \u0396\u03C9\u03AD\u03C2 (\u03B3\u03CD\u03C1\u03BF\u03C5\u03C2), \u03C0\u03BF\u03C5
      \u03BC\u03C0\u03BF\u03C1\u03BF\u03CD\u03BD \u03BD\u03B1 \u03B1\u03C5\u03BE\u03B7\u03B8\u03BF\u03CD\u03BD
      \u03AE \u03BD\u03B1 \u03BC\u03B5\u03B9\u03C9\u03B8\u03BF\u03CD\u03BD \u03BC\u03AD\u03C3\u03C9
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03B9\u03BC\u03AD\u03BD\u03C9\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 5223002288128
    m_Localized: "\u0398\u03B1 \u03B2\u03C1\u03B5\u03B9\u03C2 \u03B5\u03C0\u03AF\u03C3\u03B7\u03C2
      \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1 \u03C0\u03BF\u03C5
      \u03B4\u03AF\u03BD\u03BF\u03C5\u03BD \u03A0\u0394 \u03BA\u03B1\u03B9 \u03A0\u039A
      \u03C3\u03C4\u03BF\u03BD \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC \u03AE
      \u03B1\u03C5\u03BE\u03AC\u03BD\u03BF\u03C5\u03BD \u03C4\u03B7\u03BD \u03B5\u03BC\u03B2\u03AD\u03BB\u03B5\u03B9\u03B1
      \u03BA\u03AF\u03BD\u03B7\u03C3\u03B7\u03C2 \u03C4\u03C9\u03BD \u03A3\u03C5\u03BC\u03BC\u03B1\u03C7\u03B9\u03BA\u03CE\u03BD
      \u03A6\u03B9\u03B3\u03BF\u03CD\u03C1\u03C9\u03BD."
    m_Metadata:
      m_Items: []
  - m_Id: 5251418697728
    m_Localized: "\u03A0\u03B5\u03C1\u03B9\u03C3\u03C3\u03CC\u03C4\u03B5\u03C1\u03B5\u03C2
      \u03C0\u03BB\u03B7\u03C1\u03BF\u03C6\u03BF\u03C1\u03AF\u03B5\u03C2 \u03B3\u03B9\u03B1
      \u03C4\u03B1 \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1

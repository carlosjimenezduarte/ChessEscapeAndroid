  m_SharedData: {fileID: 11400000, guid: 96de11300926c0d4e9b8e616013fe5be, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10415656960
    m_Localized: Als er den Raum 100 erreichte, erhielt der Mann einen unerwarteten
      Besuch.
    m_Metadata:
      m_Items: []
  - m_Id: 13158731776
    m_Localized: Der Dschinn gratulierte ihm zu seinem Einsatz und ermutigte ihn,
      bis zum Ende durchzuhalten.
    m_Metadata:
      m_Items: []
  - m_Id: 17453699072
    m_Localized: "Dann sprach er von der Existenz einer Legend\xE4ren Truhe\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 20037390336
    m_Localized: "\u201E\u2026ein Schatz, der nur mit den drei Fragmenten des Heiligen
      Schl\xFCssels ge\xF6ffnet werden kann\u201C, erkl\xE4rte der Dschinn."
    m_Metadata:
      m_Items: []
  - m_Id: 22855962624
    m_Localized: "\u201EWenn du es schaffst, diese Truhe zu \xF6ffnen, wirst du aufh\xF6ren,
      nur eine Figur zu sein\u2026 und ein wahrer Gekr\xF6nter K\xF6nig werden\u201C,
      versicherte der Dschinn."
    m_Metadata:
      m_Items: []
  - m_Id: 27385810944
    m_Localized: "Mit diesem Versprechen erneuerte der Mann seine Kr\xE4fte und nahm
      die Herausforderungen an, die noch vor ihm lagen."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

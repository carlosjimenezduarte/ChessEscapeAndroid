      m_Items: []
  - m_Id: 69861527552
    m_Localized: "\u041A\u0430\u0440\u043B\u043E\u0441\u0443 \u0442\u0430\u043A\u0436\u0435
      \u043D\u0443\u0436\u043D\u043E \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443 ChatGPT, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
      \u0432\u0438\u0434\u0435\u043E\u0438\u0433\u0440\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 83283300352
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0447\u0430\u0448\u043A\u0430
      \u043A\u043E\u0444\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u041A\u0430\u0440\u043B\u043E\u0441\u0443
      \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0438\u0433\u0440\u044B
      \u0441 \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u044D\u043D\u0442\u0443\u0437\u0438\u0430\u0437\u043C\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 133010968576
    m_Localized: "\u041A\u0430\u0440\u043B\u043E\u0441 \u0442\u0430\u043A\u0436\u0435
      \u0445\u043E\u0447\u0435\u0442 \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
      \u043F\u043E\u0434\u043F\u0438\u0441\u043A\u0443 \u043D\u0430 Dofus, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u044F\u0442\u044C\u0441\u044F

  m_SharedData: {fileID: 11400000, guid: 4d7c9e7db44e66f4aa84fe9d686bf156, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 230618705920
    m_Localized: "\uCCB4\uC2A4\uC774\uC2A4\uCF00\uC774\uD504 \uD29C\uD1A0\uB9AC\uC5BC\uC5D0
      \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 237124071424
    m_Localized: "ChessEscape\uB294 \uCD1D 204\uAC1C\uC758 \uB808\uBCA8\uC5D0 \uAC78\uCCD0
      \uC9C4\uD589\uB418\uBA70, \uC804\uD1B5\uC801\uC778 \uCCB4\uC2A4\uD310\uC774
      \uB2F9\uC2E0\uC758 \uC9C0\uC131\uC744 \uC2DC\uD5D8\uD558\uB294 \uBB34\uB300\uAC00
      \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 240546623488
    m_Localized: "\uBAA9\uD45C\uB294 \uC655\uC744 \uC624\uB978\uCABD \uC704 \uCE78\uAE4C\uC9C0
      \uC774\uB3D9\uC2DC\uD0A4\uB294 \uAC83\uC785\uB2C8\uB2E4. \uADF8\uACF3\uC5D0\uB294
      \uBB38\uC774 \uC788\uC73C\uBA70, \uC804\uD1B5\uC801\uC778 \uCCB4\uC2A4\uD310\uC758
      H8\uC5D0 \uD574\uB2F9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1643788775424
    m_Localized: "\uC655\uC740 \uD56D\uC0C1 \uC67C\uCABD \uC544\uB798 \uCE78, \uC989
      A1\uC5D0\uC11C \uC2DC\uC791\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1674725961728
    m_Localized: "\uC655\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C \uB9E4 \uD134\uB9C8\uB2E4
      3 \uC774\uB3D9 \uD3EC\uC778\uD2B8 (MP) \uB97C \uAC00\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1708913733632
    m_Localized: "\uC655\uC744 \uC120\uD0DD\uD558\uBA74 \uC774\uB3D9 \uBC94\uC704\uAC00
      \uCD08\uB85D\uC0C9\uC73C\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1739418906624
    m_Localized: "\uD3F0\uC774\uB098 \uB2E4\uB978 \uC544\uAD70 \uB9D0(\uC608: \uB098\uC774\uD2B8,
      \uBE44\uC20D, \uB8E9, \uD038)\uC744 \uC120\uD0DD\uD588\uC744 \uB54C\uB3C4 \uB3D9\uC77C\uD558\uAC8C
      \uC791\uB3D9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4847662411776
    m_Localized: "\uAC19\uC740 \uB9D0\uC744 \uB2E4\uC2DC \uB204\uB974\uBA74 \uC774\uB3D9
      \uBC94\uC704 \uD45C\uC2DC\uAC00 \uAEBC\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4782298378240
    m_Localized: "\u201C\uC2DC\uC791\u201D \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uC655\uC774 \uAE30\uBCF8\uC801\uC73C\uB85C \uC120\uD0DD\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5022481002496
    m_Localized: "\uC655\uACFC \uC544\uAD70 \uB9D0\uC740 \uC801 \uB9D0\uC774 \uACF5\uACA9
      \uBC94\uC704 \uC548\uC5D0 \uC788\uC73C\uBA74 \uC81C\uAC70\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC774\uB54C \uB9C8\uC820\uD0C0 \uCE78\uC774 \uBE5B\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5100088209408
    m_Localized: "\uC801 \uB9D0\uC744 \uB204\uB974\uBA74 \uCE58\uBA85\uC801 \uACF5\uACA9
      \uBC94\uC704\uC640 \uC6D0\uAC70\uB9AC \uACF5\uACA9 \uBC94\uC704\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4.
      \uB2E4\uC2DC \uB204\uB974\uBA74 \uD45C\uC2DC\uAC00 \uAEBC\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5127837724672
    m_Localized: "\uC655\uC740 \uAE30\uBCF8\uC801\uC73C\uB85C \uB9E4 \uD134\uB9C8\uB2E4
      5 \uD589\uB3D9 \uD3EC\uC778\uD2B8 (AP) \uB97C \uAC00\uC9D1\uB2C8\uB2E4. \uC774\uB294
      \uC544\uAD70 \uB9D0\uC744 \uC774\uB3D9\uC2DC\uD0A4\uAE30 \uC704\uD574 \uD544\uC694\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5158242234368
    m_Localized: "\uAC01 \uD134\uC740 30\uCD08 \uB3D9\uC548 \uC9C0\uC18D\uB429\uB2C8\uB2E4.
      \uD669\uAE08 \uC2DC\uACC4\uB97C \uC5BB\uC73C\uBA74 \uADF8 \uD134\uC5D0 15\uCD08\uAC00
      \uCD94\uAC00\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5188302811136
    m_Localized: "\uC655\uC740 7 \uC0DD\uBA85 (\uD134) \uC744 \uAC00\uC9C0\uBA70,
      \uC544\uC774\uD15C\uC5D0 \uB530\uB77C \uB298\uC5B4\uB098\uAC70\uB098 \uC904\uC5B4\uB4ED\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5223002288128
    m_Localized: "\uB610\uD55C \uC655\uC5D0\uAC8C AP\uC640 MP\uB97C \uC8FC\uAC70\uB098
      \uC544\uAD70 \uB9D0\uC758 \uC774\uB3D9 \uBC94\uC704\uB97C \uB298\uB824\uC8FC\uB294
      \uC544\uC774\uD15C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5251418697728
    m_Localized: "\uC544\uC774\uD15C\uACFC \uB9D0\uC5D0 \uB300\uD55C \uB354 \uB9CE\uC740
      \uC815\uBCF4\uB294 ChessEscape \uCF54\uB371\uC2A4\uC5D0\uC11C \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5284742443008
    m_Localized: "\uC0C8 \uD398\uC774\uC9C0\uB97C \uC5BB\uC73C\uBA74 \uC54C\uB9BC
      \uC778\uD130\uD398\uC774\uC2A4\uC5D0\uC11C \uC54C\uB824\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 5317822918656
    m_Localized: "\uC774\uC81C \uB05D\uC785\uB2C8\uB2E4! \uC655\uC744 \uCD5C\uC885
      \uBC29\uAE4C\uC9C0 \uC778\uB3C4\uD558\uB294 \uBAA8\uD5D8\uC744 \uC2DC\uC791\uD558\uC138\uC694.\n\uB2F9\uC2E0\uC740
      \uD574\uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 262470894759936
    m_Localized: "\uC801 \uB9D0\uC774 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744 \uD558\uBA74,
      \uC655\uC758 MP\uAC00 \uAC10\uC18C\uD558\uAC70\uB098 \uC544\uAD70 \uB9D0\uC77C
      \uACBD\uC6B0 AP\uAC00 \uAC10\uC18C\uD569\uB2C8\uB2E4. \uC801 \uB9D0\uC774 \uD22C\uC601\uD558\uB294
      \uC704\uD611 \uC120\uC73C\uB85C \uADF8\uAC83\uC744 \uC54C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 397500686151680
    m_Localized: "\uC774\uAC83\uC740 ChessEscape\uC758 \uC138\uACC4\uB97C \uD615\uC131\uD558\uB294
      \uC624\uBE0C\uC81D\uD2B8\uB4E4\uC758 \uC2DC\uAC01\uC801 \uC694\uC57D\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

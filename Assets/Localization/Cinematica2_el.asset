  m_TableData:
  - m_Id: 10415656960
    m_Localized: "\u03A6\u03C4\u03AC\u03BD\u03BF\u03BD\u03C4\u03B1\u03C2 \u03C3\u03C4\u03B7\u03BD
      \u03B1\u03AF\u03B8\u03BF\u03C5\u03C3\u03B1 100, \u03BF \u03AC\u03BD\u03C4\u03C1\u03B1\u03C2
      \u03B4\u03AD\u03C7\u03C4\u03B7\u03BA\u03B5 \u03BC\u03B9\u03B1 \u03B1\u03C0\u03C1\u03CC\u03C3\u03BC\u03B5\u03BD\u03B7
      \u03B5\u03C0\u03AF\u03C3\u03BA\u03B5\u03C8\u03B7."
    m_Metadata:
      m_Items: []
  - m_Id: 13158731776
    m_Localized: "\u03A4\u03BF \u03A4\u03B6\u03AF\u03BD\u03B9 \u03C4\u03BF\u03BD
      \u03C3\u03C5\u03BD\u03B5\u03C7\u03AC\u03C1\u03B7 \u03B3\u03B9\u03B1 \u03C4\u03B7\u03BD
      \u03B1\u03C6\u03BF\u03C3\u03AF\u03C9\u03C3\u03AE \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9
      \u03C4\u03BF\u03BD \u03B5\u03BD\u03B8\u03AC\u03C1\u03C1\u03C5\u03BD\u03B5 \u03BD\u03B1
      \u03B5\u03C0\u03B9\u03BC\u03B5\u03AF\u03BD\u03B5\u03B9 \u03BC\u03AD\u03C7\u03C1\u03B9
      \u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 17453699072
    m_Localized: "\u03A3\u03C4\u03B7 \u03C3\u03C5\u03BD\u03AD\u03C7\u03B5\u03B9\u03B1
      \u03C4\u03BF\u03C5 \u03BC\u03AF\u03BB\u03B7\u03C3\u03B5 \u03B3\u03B9\u03B1
      \u03C4\u03B7\u03BD \u03CD\u03C0\u03B1\u03C1\u03BE\u03B7 \u03B5\u03BD\u03CC\u03C2
      \u0398\u03C1\u03C5\u03BB\u03B9\u03BA\u03BF\u03CD \u03A3\u03B5\u03BD\u03C4\u03BF\u03C5\u03BA\u03B9\u03BF\u03CD\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 20037390336
    m_Localized: "\xAB\u2026\u03AD\u03BD\u03B1\u03C2 \u03B8\u03B7\u03C3\u03B1\u03C5\u03C1\u03CC\u03C2
      \u03C0\u03BF\u03C5 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03B1\u03BD\u03BF\u03B9\u03C7\u03C4\u03B5\u03AF
      \u03BC\u03CC\u03BD\u03BF \u03BC\u03B5 \u03C4\u03B1 \u03C4\u03C1\u03AF\u03B1
      \u03B8\u03C1\u03B1\u03CD\u03C3\u03BC\u03B1\u03C4\u03B1 \u03C4\u03BF\u03C5 \u0399\u03B5\u03C1\u03BF\u03CD
      \u039A\u03BB\u03B5\u03B9\u03B4\u03B9\u03BF\u03CD\xBB, \u03B4\u03AE\u03BB\u03C9\u03C3\u03B5
      \u03C4\u03BF \u03A4\u03B6\u03AF\u03BD\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 22855962624
    m_Localized: "\xAB\u0391\u03BD \u03BA\u03B1\u03C4\u03B1\u03C6\u03AD\u03C1\u03B5\u03B9\u03C2
      \u03BD\u03B1 \u03B1\u03BD\u03BF\u03AF\u03BE\u03B5\u03B9\u03C2 \u03B1\u03C5\u03C4\u03CC
      \u03C4\u03BF \u03A3\u03B5\u03BD\u03C4\u03BF\u03CD\u03BA\u03B9, \u03B8\u03B1
      \u03C0\u03AC\u03C8\u03B5\u03B9\u03C2 \u03BD\u03B1 \u03B5\u03AF\u03C3\u03B1\u03B9
      \u03B1\u03C0\u03BB\u03CE\u03C2 \u03AD\u03BD\u03B1 \u03A0\u03B9\u03CC\u03BD\u03B9\u2026
      \u03BA\u03B1\u03B9 \u03B8\u03B1 \u03B3\u03AF\u03BD\u03B5\u03B9\u03C2 \u03AD\u03BD\u03B1\u03C2
      \u03B1\u03BB\u03B7\u03B8\u03B9\u03BD\u03CC\u03C2 \u03A3\u03C4\u03AD\u03C6\u03B5\u03C4\u03B1\u03B9
      \u0392\u03B1\u03C3\u03B9\u03BB\u03B9\u03AC\u03C2\xBB, \u03B4\u03B9\u03B1\u03B2\u03B5\u03B2\u03B1\u03AF\u03C9\u03C3\u03B5
      \u03C4\u03BF \u03A4\u03B6\u03AF\u03BD\u03B9."
    m_Metadata:
      m_Items: []
  - m_Id: 27385810944
    m_Localized: "\u039C\u03B5 \u03B1\u03C5\u03C4\u03AE \u03C4\u03B7\u03BD \u03C5\u03C0\u03CC\u03C3\u03C7\u03B5\u03C3\u03B7,
      \u03BF \u03AC\u03BD\u03C4\u03C1\u03B1\u03C2 \u03B1\u03BD\u03B1\u03BD\u03AD\u03C9\u03C3\u03B5
      \u03C4\u03B9\u03C2 \u03B4\u03C5\u03BD\u03AC\u03BC\u03B5\u03B9\u03C2 \u03C4\u03BF\u03C5
      \u03BA\u03B1\u03B9 \u03B1\u03C0\u03BF\u03B4\u03AD\u03C7\u03C4\u03B7\u03BA\u03B5
      \u03C4\u03B9\u03C2 \u03C0\u03C1\u03BF\u03BA\u03BB\u03AE\u03C3\u03B5\u03B9\u03C2
      \u03C0\u03BF\u03C5 \u03B1\u03BA\u03CC\u03BC\u03B7 \u03C4\u03BF\u03BD \u03C0\u03B5\u03C1\u03AF\u03BC\u03B5\u03BD\u03B1\u03BD."
    m_Metadata:
      m_Items: []
  references:

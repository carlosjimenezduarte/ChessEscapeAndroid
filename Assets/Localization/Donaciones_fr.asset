  m_TableData:
  - m_Id: 39297634304
    m_Localized: "Vous pouvez soutenir Saint Martin Games directement gr\xE2ce aux
      dons sur ChessEscape.com"
    m_Metadata:
      m_Items: []
  - m_Id: 53583433728
    m_Localized: Les croquettes de Willow ne se paient pas toutes seules !
    m_Metadata:
      m_Items: []
  - m_Id: 69861527552
    m_Localized: "Carlos doit aussi payer l\u2019abonnement \xE0 ChatGPT pour continuer
      \xE0 d\xE9velopper des jeux vid\xE9o !"
    m_Metadata:
      m_Items: []
  - m_Id: 83283300352
    m_Localized: "Une bonne tasse de caf\xE9 aidera Carlos \xE0 cr\xE9er ses jeux
      avec encore plus d\u2019enthousiasme !"
    m_Metadata:
      m_Items: []
  - m_Id: 133010968576
    m_Localized: "Carlos veut aussi payer son abonnement \xE0 Dofus pour continuer
      \xE0 s\u2019inspirer tout en s\u2019amusant !"
    m_Metadata:
      m_Items: []
  - m_Id: 148915769344
    m_Localized: "Carlos r\xEAve d\u2019acheter sa propre maison\u2026 ton soutien
      construit aussi cet avenir !"
    m_Metadata:
      m_Items: []
  - m_Id: 163209957376
    m_Localized: En savoir plus

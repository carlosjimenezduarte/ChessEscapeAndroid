  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Cinematica1_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: c2d267b057669f54da106f121bf5e76b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 164489220096
    m_Localized: "C\u2019era un uomo che aveva perso tutto e viaggi\xF2 senza meta
      per molti anni."
    m_Metadata:
      m_Items: []
  - m_Id: 170336079872
    m_Localized: "Tra antiche rovine trov\xF2 una lampada d\u2019oro."
    m_Metadata:
      m_Items: []
  - m_Id: 172420648960
    m_Localized: "Da essa emerse un Genio splendente, che offr\xEC di esaudire un
      unico desiderio."
    m_Metadata:
      m_Items: []
  - m_Id: 177554477056
    m_Localized: "\xABVoglio essere Re. Voglio un Regno tutto mio\xBB, rispose l\u2019uomo."
    m_Metadata:
      m_Items: []
  - m_Id: 181543260160
    m_Localized: "Il Genio rispose: \xABIl tuo desiderio sar\xE0 esaudito. Ma nessun
      Regno \xE8 concesso senza prove.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 184470884352
    m_Localized: "\xABSe davvero vuoi essere Re, entra subito in questa sala. Il
      tuo Regno ti aspetta\xBB, lo invit\xF2 il Genio."
    m_Metadata:
      m_Items: []
  - m_Id: 186479955968
    m_Localized: "Emozionato, l\u2019uomo entr\xF2 nella prima sala, dove scopr\xEC
      con delusione che era piena di pezzi degli scacchi."
    m_Metadata:
      m_Items: []
  - m_Id: 188791017472
    m_Localized: "E allora il Genio trasform\xF2 l\u2019uomo in un Re degli scacchi,
      la cui pelle si fuse con quella della scacchiera."
    m_Metadata:
      m_Items: []
  - m_Id: 190506487808
    m_Localized: Duecento sale di prova attendono il Re. Duecento prove per misurare
      la convinzione del suo desiderio. Duecento prove per conquistare il suo Regno.
    m_Metadata:
      m_Items: []
  - m_Id: 193123733504
    m_Localized: "Aiuterai quest\u2019uomo a diventare un vero Re? Sarai capace di
      guidarlo?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []

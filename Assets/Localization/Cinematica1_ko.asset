  m_TableData:
  - m_Id: 164489220096
    m_Localized: "\uBAA8\uB4E0 \uAC83\uC744 \uC783\uACE0 \uC218\uB144 \uB3D9\uC548
      \uBC29\uD669\uD55C \uD55C \uB0A8\uC790\uAC00 \uC788\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 170336079872
    m_Localized: "\uACE0\uB300\uC758 \uD3D0\uD5C8 \uC18D\uC5D0\uC11C \uADF8\uB294
      \uD669\uAE08 \uB7A8\uD504\uB97C \uBC1C\uACAC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 172420648960
    m_Localized: "\uADF8\uACF3\uC5D0\uC11C \uBE5B\uB098\uB294 \uC9C0\uB2C8\uAC00
      \uB098\uD0C0\uB098 \uB2E8 \uD558\uB098\uC758 \uC18C\uC6D0\uC744 \uB4E4\uC5B4\uC8FC\uACA0\uB2E4\uACE0
      \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 177554477056
    m_Localized: "\u201C\uC655\uC774 \uB418\uACE0 \uC2F6\uB2E4. \uB098\uB9CC\uC758
      \uC655\uAD6D\uC744 \uAC16\uACE0 \uC2F6\uB2E4\u201D\uACE0 \uB0A8\uC790\uB294
      \uB300\uB2F5\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 193123733504
    m_Localized: "\uC774 \uB0A8\uC790\uAC00 \uC9C4\uC815\uD55C \uC655\uC774 \uB418\uB3C4\uB85D
      \uB3C4\uC640\uC904 \uAC83\uC778\uAC00? \uB124\uAC00 \uADF8\uB97C \uC774\uB04C
      \uC218 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 190506487808
    m_Localized: "\uC774\uBC31 \uAC1C\uC758 \uC2DC\uB828\uC758 \uBC29\uC774 \uC655\uC744
      \uAE30\uB2E4\uB9B0\uB2E4. \uC774\uBC31 \uBC88\uC758 \uC2DC\uB828\uC774 \uADF8\uC758
      \uC695\uB9DD\uC758 \uD655\uC2E0\uC744 \uC2DC\uD5D8\uD55C\uB2E4. \uC774\uBC31
      \uBC88\uC758 \uC2DC\uB828\uC774 \uADF8\uC758 \uC655\uAD6D\uC744 \uC815\uBCF5\uD558\uAC8C
      \uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 188791017472
    m_Localized: "\uADF8\uB9AC\uACE0 \uC9C0\uB2C8\uB294 \uADF8 \uB0A8\uC790\uB97C
      \uCCB4\uC2A4\uC758 \uC655\uC73C\uB85C \uBC14\uAFB8\uC5C8\uACE0, \uADF8\uC758
      \uD53C\uBD80\uB294 \uBC14\uB451\uD310\uACFC \uD558\uB098\uAC00 \uB418\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 181543260160
    m_Localized: "\uC9C0\uB2C8\uB294 \uC774\uB807\uAC8C \uB9D0\uD588\uB2E4. \u201C\uB124
      \uC18C\uC6D0\uC740 \uC774\uB8E8\uC5B4\uC9C8 \uAC83\uC774\uB2E4. \uD558\uC9C0\uB9CC
      \uC5B4\uB5A4 \uC655\uAD6D\uB3C4 \uC2DC\uB828 \uC5C6\uC774 \uC8FC\uC5B4\uC9C0\uC9C0
      \uC54A\uB294\uB2E4.\u201D"
    m_Metadata:
      m_Items: []
  - m_Id: 184470884352
    m_Localized: "\u201C\uC815\uB9D0\uB85C \uC655\uC774 \uB418\uACE0 \uC2F6\uB2E4\uBA74,
      \uC9C0\uAE08 \uB2F9\uC7A5 \uC774 \uBC29\uC5D0 \uB4E4\uC5B4\uAC00\uB77C. \uB124
      \uC655\uAD6D\uC774 \uB108\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4\u201D\uACE0
      \uC9C0\uB2C8\uB294 \uCD08\uB300\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 186479955968
    m_Localized: "\uD765\uBD84\uD55C \uB0A8\uC790\uB294 \uCCAB \uBC88\uC9F8 \uBC29\uC5D0
      \uB4E4\uC5B4\uAC14\uACE0, \uC2E4\uB9DD\uC2A4\uB7FD\uAC8C\uB3C4 \uADF8\uACF3\uC774
      \uCCB4\uC2A4 \uB9D0\uB4E4\uB85C \uAC00\uB4DD \uCC28 \uC788\uB2E4\uB294 \uAC83\uC744
      \uBC1C\uACAC\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
